      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-02-01-preview",
      "properties": {
        "displayName": "M6 R08 - Burst of discovery commands",
        "description": "Three or more different discovery tools run by the same account on the same machine within fifteen minutes.",
        "severity": "Low",
        "enabled": true,
        "query": "SecurityEvent\n| where EventID == 4688\n| extend Tool = tolower(tostring(split(NewProcessName, \"\\\\\")[-1]))\n| where Tool in (\"whoami.exe\", \"net.exe\", \"ipconfig.exe\", \"systeminfo.exe\", \"nltest.exe\", \"quser.exe\")\n| summarize ToolCount = dcount(Tool), Tools = make_set(Tool), Commands = make_set(CommandLine, 20), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated) by SubjectAccount, Computer\n| where ToolCount >= 3",
        "queryFrequency": "PT10M",
        "queryPeriod": "PT15M",
